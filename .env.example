# Copy to .env and fill in. NEVER commit .env to git.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-server-only
ADMIN_SECRET=any-long-random-string
NEXT_PUBLIC_SITE_URL=https://tajgifts.netlify.app
# Meta (Facebook/Instagram) Pixel ID — paste after creating it in Events Manager; leave empty to disable
NEXT_PUBLIC_META_PIXEL_ID=
# ── Zero-touch order notifications (AUTO-NOTIFY-SETUP.md) — all optional ──
# Official WhatsApp Cloud API bot (image header + template):
# META_WA_TOKEN=  META_WA_PHONE_ID=  META_WA_TO=917668819833  META_WA_TEMPLATE=taj_order_alert
# Telegram bot (free, instant, photo + full brief):
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# CallMeBot WhatsApp text gateway (provider AT CAPACITY — skip unless you already hold a key):
CALLMEBOT_API_KEY=
CALLMEBOT_PHONE=
# ── Email alerts (recommended zero-touch channel) ──
ORDER_NOTIFY_EMAIL=you@gmail.com
# Option A: Resend (3-min setup, free 100/day):
RESEND_API_KEY=
# RESEND_FROM=Taj Gifts Studio <onboarding@resend.dev>
# Option B: your own Gmail via app password (no new account):
SMTP_USER=
SMTP_APP_PASSWORD=
# SMTP_HOST=smtp.gmail.com
# ── Powerful preview images (optional; falls back to free recipe without keys) ──
GEMINI_API_KEY=
# OPENAI_API_KEY=
