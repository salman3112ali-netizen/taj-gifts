# Copy this file to .env locally. In Netlify, add the same values under
# Site configuration → Environment variables. Never commit a real .env file.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-server-only
# Create a long random value (32+ characters). Required for owner sessions and
# delivery tracking security. Keep it server-side only.
ADMIN_SECRET=replace-with-a-long-random-secret
# Optional separate 32+ character key. If absent, ADMIN_SECRET protects OTPs too.
DELIVERY_OTP_SECRET=
NEXT_PUBLIC_SITE_URL=https://tajgifts.netlify.app

# ── Owner order alerts — optional but strongly recommended ──
ORDER_NOTIFY_EMAIL=your-owner-email@example.com
# Option A: Resend (free tier available)
RESEND_API_KEY=
RESEND_FROM=Taj Gifts Studio <orders@tajgifts.in>
# Option B: Gmail/SMTP app password (never use your normal Gmail password)
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
MAIL_FROM=Taj Gifts <orders@tajgifts.in>

# ── Owner WhatsApp/Telegram/webhook alerts (optional) ──
META_WA_TOKEN=
META_WA_PHONE_ID=
META_WA_TO=917668819833
META_WA_TEMPLATE=taj_order_alert
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ORDER_NOTIFY_WEBHOOK=

# ── Delivery OTP recipient channels (optional; private tracking remains live) ──
# Meta utility template body variables: order code, 6-digit code, expiry time.
META_CUSTOMER_OTP_TEMPLATE=
META_CUSTOMER_OTP_LANGUAGE=en
# A verified server-to-server endpoint for your SMS/WhatsApp provider.
DELIVERY_OTP_WEBHOOK=

# ── Payments / optional powerful previews ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=
